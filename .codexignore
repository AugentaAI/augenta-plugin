# Keep the shipped plugin bundle lean — none of this is needed at runtime.
node_modules/
__tests__/
*.test.ts
bun.lock
*.log
.DS_Store

# Contributor tooling: the repo's own dev skills (PR review, issue triage) that the
# agentic CI workflows run. Neither manifest reaches .claude/ — both declare
# "skills": "./skills/" — so this is bundle hygiene, not a correctness fix.
.claude/
